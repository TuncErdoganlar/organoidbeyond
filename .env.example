# -----------------------------------------------------------------------------
# OrganoidBeyond — environment variables
#
# Copy this file to `.env.local` (which is gitignored) and fill in any keys you
# want to use. All Vite-exposed variables MUST be prefixed with VITE_.
# -----------------------------------------------------------------------------

# Optional. An NCBI E-utilities API key raises the rate limit from
# 3 req/sec to 10 req/sec. Get one at:
#   https://www.ncbi.nlm.nih.gov/account/  →  "API Key Management"
# Leave blank to run unauthenticated (still works, just slower).
VITE_PUBMED_API_KEY=

# Optional. An email NCBI will associate with your requests as a courtesy
# (recommended by NCBI; not strictly required).
VITE_PUBMED_TOOL_EMAIL=
